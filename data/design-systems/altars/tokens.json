{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Altars",
  "version": "1.0.0",
  "description": "Design tokens oficiais da Altars — Método Aurora. Sans-serif fina, off-white, dourado, minimalista com espaço negativo.",
  "color": {
    "bg": {
      "value": "#fbfaf7",
      "type": "color",
      "description": "Fundo exclusivo off-white, quase-white quente. Nunca usar branco puro."
    },
    "panel": {
      "value": "#fdfcf8",
      "type": "color",
      "description": "Painéis ligeiramente distintos do fundo, nunca branco puro."
    },
    "ink": {
      "value": "#1a1815",
      "type": "color",
      "description": "Tinta principal (quase-preto quente para contraste)."
    },
    "text": {
      "value": "#2b2823",
      "type": "color",
      "description": "Texto corrido / corpo de texto."
    },
    "muted": {
      "value": "#57524a",
      "type": "color",
      "description": "Texto secundário / cinza-toupeira (>=4.5:1 sobre bg)."
    },
    "gold": {
      "value": "#b9974a",
      "type": "color",
      "description": "Dourado acento primário (CTAs, linhas de secção, pills)."
    },
    "goldSoft": {
      "value": "#d9c9a0",
      "type": "color",
      "description": "Dourado muito claro para linhas secundárias e molduras."
    },
    "goldDeep": {
      "value": "#7c5f31",
      "type": "color",
      "description": "Dourado escuro / castanho profundo para kickers, acentos em h1 e ênfase."
    },
    "line": {
      "value": "#e6e0d2",
      "type": "color",
      "description": "Linhas divisórias suaves."
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "value": "-apple-system, 'Helvetica Neue', Helvetica, 'Segoe UI', sans-serif",
        "type": "fontFamily"
      }
    },
    "fontWeight": {
      "thin": { "value": "200", "type": "fontWeight" },
      "light": { "value": "300", "type": "fontWeight" },
      "regular": { "value": "400", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" }
    },
    "fontSize": {
      "h1": { "value": "26pt", "type": "dimension" },
      "h2": { "value": "17pt", "type": "dimension" },
      "h3": { "value": "11pt", "type": "dimension" },
      "lead": { "value": "11.5pt", "type": "dimension" },
      "body": { "value": "10.5pt", "type": "dimension" },
      "caption": { "value": "8pt", "type": "dimension" }
    }
  },
  "page": {
    "size": "A4",
    "margin": "20mm 22mm 14mm 22mm"
  },
  "rules": {
    "prohibitions": [
      "Fundo escuro (Altars é sempre clara)",
      "Branco puro (#FFFFFF)",
      "Fontes serifadas",
      "Emoji em documentos formais",
      "Gradientes de texto decorativos"
    ]
  }
}
